# Copy this file to .env next to docker-compose.yaml before starting the app.
# Set a unique, long random database password.
# SQLAlchemy builds the connection URL safely, including passwords with URL characters.
POSTGRES_DB=immich_insights
POSTGRES_USER=immich_insights
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Existing Docker network used by Immich. Check the actual name in your Docker UI.
IMMICH_DOCKER_NETWORK=immich-app_default

# Set to true only when users access Immich Insights through HTTPS.
APP_COOKIE_SECURE=false
